# Supabase Auth (proiect Supabase NOU, separat de SOI_CRM — staging și
# producție sunt proiecte Supabase diferite, nu doar scheme diferite).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Conexiune Postgres cu rolul de runtime `app_user` (NOBYPASSRLS) — vezi
# documentation/rls-setup.sql. NU folosi rolul owner/postgres aici.
# Folosește pooler-ul Supavisor (IPv4), NU conexiunea directă (IPv6-only —
# Vercel Functions nu o pot rezolva). Format:
# postgresql://app_user.<project-ref>:<parola>@aws-<shard>-<regiune>.pooler.supabase.com:6543/postgres
# Shard-ul exact (aws-0-/aws-1-/...) se ia din Project Settings → Database →
# Connection pooling — NU se ghicește din regiune.
DATABASE_URL=

# Conexiune Postgres cu rolul `migrator` (owner de schemă) — folosită DOAR
# de drizzle-kit (generate/push/migrate), NICIODATĂ de aplicația care rulează.
# Tot prin pooler, port 5432 (session mode — mai sigur pentru DDL):
# postgresql://migrator.<project-ref>:<parola>@aws-<shard>-<regiune>.pooler.supabase.com:5432/postgres
MIGRATOR_DATABASE_URL=

# Platforma NU are cont Stripe: fiecare ONG își conectează propriul cont din
# Setări → Plăți donații (cheile lui, criptate în baza de date). Pentru criptare:
# 32 de octeți în base64 — node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Odată setată și folosită, NU o schimba: cheile deja salvate devin ilizibile.
ORG_SECRETS_KEY=

# Netopia Payments — încasarea abonamentelor platformei (49/149/299 lei/lună).
# Cheile se iau din contul Netopia (admin.netopia-payments.com → Profil → Securitate;
# semnătura POS și cheia publică a POS-ului). NETOPIA_ENV="live" doar la producție;
# implicit "sandbox", ca o configurare incompletă să nu încaseze bani reali.
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
NETOPIA_PUBLIC_KEY=
NETOPIA_ENV=sandbox

# Monitorizare erori (opțional). Fără DSN nu se trimite nimic. Proiect Sentry pe regiunea EU.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Semnătură digitală BoldSign (opțional). Cont pe regiunea SUA: BOLDSIGN_API_URL=https://api.boldsign.com
BOLDSIGN_API_KEY=
BOLDSIGN_API_URL=

# Twilio Voice: prefixele de destinație permise la apeluri (implicit doar România).
# Protejează contul Twilio de apeluri către numere premium/internaționale.
# TWILIO_ALLOWED_PREFIXES=+40
